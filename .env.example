# ==============================================================================
# Eram Style Advisor — Variables d'environnement
# ==============================================================================
# Copier ce fichier en `.env.local` et remplir les valeurs.
# `.env.local` est ignoré par git (cf. .gitignore).
# ==============================================================================

# Anthropic Claude API — clé server-only, JAMAIS préfixée NEXT_PUBLIC_*
ANTHROPIC_API_KEY=sk-ant-...

# Limite de requêtes par IP par minute pour /api/recommend (cf. cybersécurité)
RATE_LIMIT_PER_MINUTE=10

# ============ À ajouter J1 après-midi (Supabase) ============
# Supabase — instance région eu-west (cf. ADR-001)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=  # JAMAIS exposée côté client !

# ============ À ajouter J2 (Plausible) ============
# Plausible Analytics — UE, sans cookie
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=eram-style-advisor.vercel.app
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js
